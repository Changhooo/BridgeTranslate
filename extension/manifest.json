{
  "manifest_version": 3,
  "name": "桥译 · Bridge Translate",
  "version": "1.0.0",
  "description": "Claude 网页中文提问一键转英文，回答自动中英对照，使用你自己的模型接口。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开桥译侧边栏",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "sidepanel.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "api.mjs",
        "render.mjs",
        "dom-text.mjs",
        "clipboard.mjs",
        "paragraphs.mjs",
        "titles.mjs"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}

<Window x:Class="BridgeTranslate.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="桥译 · Windows 独立版" Width="1370" Height="920" MinWidth="1060" MinHeight="740" Background="#F2F4EE" FontFamily="Microsoft YaHei UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="桥译" Foreground="#237663" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="BRIDGE TRANSLATE  /  独立运行 · 自带模型" Foreground="#7B8F83" FontSize="11"/></StackPanel><CheckBox x:Name="PinBox" Content="窗口置顶" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Pin_Changed" Unchecked="Pin_Changed"/></DockPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,6,0">
<Border Background="White" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="连接你的 CC" FontSize="17" FontWeight="SemiBold"/><ComboBox x:Name="WindowBox"/><WrapPanel><Button Content="刷新窗口" Click="RefreshWindows_Click"/><Button Content="连接所选窗口" Click="Connect_Click"/></WrapPanel><WrapPanel><Button Content="绑定输入框" Click="BindEditor_Click"/><Button Content="绑定发送按钮" Click="BindSend_Click"/></WrapPanel><TextBlock x:Name="TargetLabel" Text="尚未连接。目标不明确时仅生成英文预览。" TextWrapping="Wrap" Foreground="#718176" Margin="0,7,0,0"/></StackPanel></Border>
<Border Background="White" CornerRadius="12" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="用中文，把问题说清楚" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="草稿只写在桥译里，翻译后再填入 CC。" Foreground="#718176" Margin="0,5,0,4"/>
<TextBox x:Name="ChineseBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="60000" PreviewKeyDown="ChineseBox_KeyDown"/>
<CheckBox x:Name="AutoSendBox" Content="可选：中文按 Enter 译后填入并发送"/><TextBlock Text="默认关闭；Shift+Enter 换行。请保持 CC 目标会话不变。" FontSize="11" Foreground="#718176" TextWrapping="Wrap"/>
<WrapPanel><Button x:Name="TranslateButton" Content="翻译成英文" Click="Translate_Click" Background="#237663" Foreground="White"/><Button Content="取消" Click="Cancel_Click"/></WrapPanel>
<TextBlock Text="英文预览（可以继续编辑）" Margin="0,9,0,0"/><TextBox x:Name="EnglishBox" Height="115" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="60000"/>
<WrapPanel><Button Content="复制英文" Click="CopyEnglish_Click"/><Button Content="填入 CC" Click="Fill_Click"/><Button Content="填入并发送" Click="Send_Click"/></WrapPanel></StackPanel></Border>
<Expander Header="翻译模型设置" Margin="0,14,0,10" Background="White" Padding="14"><StackPanel Margin="0,10,0,0"><TextBlock Text="接口协议"/><ComboBox x:Name="ProtocolBox" SelectedIndex="0"><ComboBoxItem Content="Chat Completions" Tag="chat"/><ComboBoxItem Content="Responses" Tag="responses"/><ComboBoxItem Content="Anthropic Messages" Tag="anthropic"/><ComboBoxItem Content="Gemini" Tag="gemini"/></ComboBox><TextBlock Text="API URL"/><TextBox x:Name="EndpointBox"/><TextBlock Text="模型 ID"/><TextBox x:Name="ModelBox"/><TextBlock Text="API Key（系统加密后保存）"/><PasswordBox x:Name="KeyBox" Padding="8" Margin="0,5,0,10"/><TextBlock Text="鉴权方式"/><ComboBox x:Name="AuthBox" SelectedIndex="0"><ComboBoxItem Content="按协议自动" Tag="auto"/><ComboBoxItem Content="Bearer" Tag="bearer"/><ComboBoxItem Content="x-api-key" Tag="x-api-key"/><ComboBoxItem Content="api-key" Tag="api-key"/><ComboBoxItem Content="x-goog-api-key" Tag="x-goog-api-key"/><ComboBoxItem Content="无密钥（本机）" Tag="none"/></ComboBox><TextBlock Text="术语表（中文 = English）"/><TextBox x:Name="GlossaryBox" Height="65" AcceptsReturn="True" MaxLength="4000"/><WrapPanel><Button Content="保存配置" Click="Save_Click"/><Button Content="测试当前配置" Click="Test_Click"/><Button Content="删除密钥" Click="ClearKey_Click"/></WrapPanel><TextBlock Text="原文仅发送到你填写的翻译 API。密钥不会进入回答阅读区。" TextWrapping="Wrap" Foreground="#718176" FontSize="11"/></StackPanel></Expander>
</StackPanel></ScrollViewer>
<Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="英文段落下，直接读中文" FontSize="20" FontWeight="SemiBold" Foreground="#24463B"/><WrapPanel Margin="0,9,0,0"><Button Content="选择会话 JSONL" Click="ChooseFile_Click"/><Button Content="绑定界面回答区域" Click="BindAnswer_Click"/><Button Content="粘贴英文回答" Click="PasteAnswer_Click"/></WrapPanel><TextBlock x:Name="SourceLabel" Text="先选定当前会话文件；也可以粘贴回答，或绑定可访问的界面文字区域。" TextWrapping="Wrap" Foreground="#718176" Margin="0,3,0,7"/>
</StackPanel>
<DockPanel Grid.Row="1" Margin="0,5,0,10"><WrapPanel DockPanel.Dock="Left"><CheckBox x:Name="AutoReplyBox" Content="自动译回答" IsChecked="True"/><ComboBox x:Name="ModeBox" Width="85" SelectedIndex="1" SelectionChanged="Mode_Changed"><ComboBoxItem Content="原文" Tag="original"/><ComboBoxItem Content="双语" Tag="bilingual"/><ComboBoxItem Content="中文" Tag="chinese"/></ComboBox><Button Content="翻译／重试" Click="Retry_Click"/><Button Content="复制中文 Markdown" Click="CopyReply_Click"/></WrapPanel><TextBlock x:Name="ProgressLabel" Foreground="#718176" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
<wv:WebView2 x:Name="Reader" Grid.Row="2" DefaultBackgroundColor="#FFFFFF"/><TextBox x:Name="FallbackReader" Grid.Row="2" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
</Grid></Border></Grid>
<TextBlock Grid.Row="2" x:Name="StatusLabel" Text="就绪 · 不使用 Mods，不修改 Claude 配置。" VerticalAlignment="Center" Foreground="#587260" TextWrapping="Wrap"/>
</Grid></Window>
